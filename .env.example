# Copy to .env.local. Do not commit .env.local.
MONGODB_URI=mongodb://127.0.0.1:27017/bazardor
MONGODB_DB=bazardor
# false works with a local standalone MongoDB; true for Atlas/replica sets.
MONGODB_TRANSACTIONS=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Server-only OAuth keys. Leave blank until your provider apps are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
BAZARDOR_API_FALLBACK_URL=https://api.abcz.workers.dev/api/bazardor
# Optional: true skips upstream API and explicitly labels the supplied snapshot.
BAZARDOR_SNAPSHOT_ONLY=false
